# Copy this file to .env and replace the values below.
# Keep .env private: never commit it or share your tokens and passwords.
# See SETUP.md for installation and upgrade instructions.

# --- Telegram and OpenAI connections ---
# Create your Telegram bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token

# Create an API key at platform.openai.com. The owner pays for all meal estimates.
OPENAI_API_KEY=replace-with-the-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# --- Administrator and user access ---
# Set your numeric Telegram user ID, not your username or phone number.
# If unknown, start the bot and send /myid in a private chat to get it.
# Then fill this in and recreate the NAS bot container (or restart a local run).
# Multiple admins: separate IDs with commas, e.g. 123456789,987654321.
# Configured admins always have access and cannot be removed through the bot.
ADMIN_TELEGRAM_USER_IDS=

# Optional one-time import for existing users. New installations can leave blank.
# UPGRADING: keep your existing IDs for the first startup of the updated bot.
# IDs are imported once when either admin IDs or allowed IDs are configured.
# After that, use Telegram's Manage users menu; editing this list has no effect.
# An empty list does NOT open access to everyone.
ALLOWED_TELEGRAM_USER_IDS=

# --- NAS database ---
# Generate a long random password using only letters and numbers, then paste
# the SAME password below and into DATABASE_URL between health_tracker: and @db.
# Keep the database name and hostname unchanged for the supplied Compose files.
POSTGRES_PASSWORD=replace-with-the-generated-database-password
DATABASE_URL=postgresql+psycopg://health_tracker:replace-with-the-generated-database-password@db/health_tracker

# Local Python run only: replace DATABASE_URL above with this value instead.
# DATABASE_URL=sqlite:///health_tracker.db
# POSTGRES_PASSWORD is unused for SQLite. Existing NAS database passwords must
# also be changed inside PostgreSQL if rotated; editing this file isn't enough.

# --- Automatic NAS updates ---
# Use YOUR GitHub owner/repository, all lowercase, matching your published image.
# Keep :latest for automatic updates. Manual builds/local Python ignore this.
BOT_IMAGE=ghcr.io/your-github-owner/health-tracker:latest

# --- Tracking preferences ---
# IANA timezone shared by all users for daily totals and reminder times.
TIMEZONE=Asia/Singapore

# Initial target for NEW users only. Each user can change theirs in Telegram.
DAILY_CALORIE_TARGET=2000
