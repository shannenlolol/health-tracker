TELEGRAM_BOT_TOKEN=replace-with-the-botfather-token
OPENAI_API_KEY=replace-with-the-openai-api-key
# Packaged bot application built by GitHub Actions for the ARM64 NAS.
BOT_IMAGE=ghcr.io/shannenlolol/health-tracker:latest

# Use the exact same generated password in both lines.
POSTGRES_PASSWORD=replace-with-the-generated-database-password
DATABASE_URL=postgresql+psycopg://health_tracker:replace-with-the-generated-database-password@db/health_tracker

OPENAI_MODEL=gpt-4.1-mini
TIMEZONE=Asia/Singapore
DAILY_CALORIE_TARGET=2000
# Comma-separated numeric IDs allowed to use the bot. Leaving this empty permits everyone.
ALLOWED_TELEGRAM_USER_IDS=replace-with-comma-separated-numeric-ids
